            "type": "string",
            "const": "Local calendar day in Asia/Kolkata, not an instant"
          },
          "state": {
            "type": "string",
            "enum": [
              "worked",
              "no_work"
            ]
          },
          "crew": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
