{
  "Content": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,119}$",
        "description": "Stable published content ID; never a path or URL."
      },
      "kind": {
        "type": "string",
        "enum": [
          "page",
          "summary",
          "cost",
          "work"
        ]
      },
      "title": {
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "canonical": {
        "type": "string",
        "format": "uri"
      },
      "last_updated": {
        "type": "string"
      },
      "revision": {
        "type": "string"
      },
      "language": {
        "type": "string",
