                    "currency": {
                      "type": "string",
                      "const": "INR"
                    },
                    "minor_unit": {
                      "type": "string",
                      "const": "paise"
                    },
                    "amount_minor": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "decimal": {
                      "type": "string"
                    }
